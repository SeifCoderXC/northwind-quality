# Copy this file to .env. .env is gitignored.
# Leave the directory and Jira values empty to run with local accounts only.
# A directory client secret must be at least 16 characters.
# It must not be the directory password or the local desk password.

QUALITY_DEMO_PASSWORD=northwind-local
LOCAL_DIRECTORY_PORT=4391
OIDC_ISSUER_URL=http://127.0.0.1:4391
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUP_CLAIM=groups
OIDC_DIRECTOR_GROUP=northwind-directors
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=NQ
